meta {
  name: Create upload request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/upload
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  top_offset: 0
  left_offset: 0
}

vars:post-response {
  requestId: id
}

script:post-response {
  bru.setVar("requestId", res.body.id);
}
